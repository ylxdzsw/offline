[offline-pwa-head]=
;`<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#f5f4f2">
<meta name="application-name" content="Offline Classic Games">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Classic Games">
<meta name="format-detection" content="telephone=no">
<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" sizes="180x180" href="./icons/apple-touch-icon.png">`

[offline-wasm]=
const {args: [name, file]} = std_call()
const compressed = read(file, 'compressed-base64')
;`<script>OfflineGames.wasm.registerEmbedded(${JSON.stringify(name)}, ${JSON.stringify(compressed)})</script>`

[offline-worker]=
const {args: [id, wasm, ...files]} = std_call()
;`<script type="application/octet-stream" id="${id}" data-wasm-module="${wasm}">${files.map(file => read(file, 'base64')).join('.')}</script>`

[offline-catalog]=
const {args: [file]} = std_call()
const catalog = JSON.parse(read(file))
;`<script>OfflineGames.catalog = ${JSON.stringify(catalog)}</script>`
